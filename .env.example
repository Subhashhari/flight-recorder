GOOGLE_API_KEY=dummy
GOOGLE_GENAI_USE_VERTEXAI=FALSE
AGENT_MODEL=TBD
JUDGE_MODEL=TBD
EMBED_MODEL=TBD
# If host port 5432 is already used by another Postgres, set FLIGHTREC_DB_PORT=5433 and use :5433 below.
FLIGHTREC_DB_PORT=5432
DATABASE_URL=postgresql+psycopg://flightrec:flightrec@127.0.0.1:5432/flightrec
SCALE_TIER=TBD
MAX_LLM_CALLS_PER_RUN=25
CHUNK_CHARS=1200
CHUNK_OVERLAP=150
RETRIEVE_TOP_K=5
PROMPT_VERSION=v1
